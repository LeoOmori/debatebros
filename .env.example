# Create a Gemini API key in Google AI Studio. Never expose this value to the browser.
GOOGLE_GENERATIVE_AI_API_KEY=

# Balanced defaults. Override these only with model IDs supported by your account.
GEMINI_DEBATE_MODEL=gemini-3.1-flash-lite
GEMINI_JUDGE_MODEL=gemini-3.1-flash-lite
# Só entra em cena quando o modelo do juiz está indisponível.
GEMINI_JUDGE_FALLBACK_MODEL=gemini-3.8-flash

# Tokens de raciocínio são cobrados como saída. 0 = mais barato.
GEMINI_THINKING_BUDGET=0

# Local development fallback. Production should keep this false.
AI_MOCK_MODE=false
AI_RATE_LIMIT_PER_MINUTE=12
METRICS_RATE_LIMIT_PER_MINUTE=30
